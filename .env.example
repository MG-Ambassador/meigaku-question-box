# ==============================================================================
# 明学の質問箱 (Meigaku Question Box) 環境変数設定例
# ==============================================================================

# ------------------------------------------------------------------------------
# フロントエンド (GitHub Pages / Next.js 静的エクスポート時)
# ※ ビルド成果物 (HTML/JS) に埋め込まれる公開値です。機密情報は絶対に含めないでください。
# ------------------------------------------------------------------------------
# Cloud Run API サーバーのベースURL (末尾スラッシュなし)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Google Identity Services (GIS) の OAuth 2.0 Web クライアントID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GitHub Pages の basePath (例: /MGA)。カスタムドメインやルート公開時は空
NEXT_PUBLIC_BASE_PATH=

# ------------------------------------------------------------------------------
# バックエンド (Cloud Run サーバー実行時)
# ※ サーバー内部のみで使用する環境変数です。
# ------------------------------------------------------------------------------
# サーバーポート
PORT=8080

# Google Cloud プロジェクトID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Cloud Firestore データベースID (デフォルトDBの場合は空または (default))
FIRESTORE_DATABASE_ID=(default)

# 管理者認証用の Google OAuth クライアントID (トークン検証用)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 運営者として許可する Google アカウントの sub / 表示名リスト (JSON形式)
# 例: [{"sub":"123456789012345678901","displayName":"明治学院 運営担当","email":"admin@example.com"}]
ADMIN_IDENTITIES=[{"sub":"your-google-sub-id","displayName":"運営担当者"}]

# レート制限用の IP ハッシュ生成キー (HMAC-SHA256 秘密鍵)
RATE_LIMIT_SECRET=generate-a-strong-random-secret-here

# CORS 許可オリジン (カンマ区切り、末尾スラッシュなし)
# 例: https://owner.github.io,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
