# ==============================================================================
# 明学の質問箱 (Meigaku Question Box) バックエンド API 環境変数設定例 (server/.env)
# ==============================================================================

# サーバーポート
PORT=8080

# 実行環境 (development | test | production)
NODE_ENV=development

# Google Cloud プロジェクトID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Cloud Firestore データベースID (デフォルトDBの場合は (default))
FIRESTORE_DATABASE_ID=(default)

# ローカルで Firestore Emulator を使用する場合のみ設定 (例: localhost:8085)
# FIRESTORE_EMULATOR_HOST=localhost:8085

# 管理者認証用の Google OAuth 2.0 Web クライアントID (トークン検証用、本番必須)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 運営者として許可する Google アカウントの sub / 表示名リスト (JSON配列または sub のカンマ区切り、本番必須)
# 例: [{"sub":"123456789012345678901","displayName":"明治学院 運営担当","email":"admin@example.com"}]
ADMIN_IDENTITIES=[{"sub":"your-google-sub-id","displayName":"運営担当者"}]

# レート制限用の IP ハッシュ生成キー (HMAC-SHA256 秘密鍵、本番必須)
RATE_LIMIT_SECRET=generate-a-strong-random-secret-here

# 質問一覧ページネーションのカーソル署名キー (HMAC-SHA256 秘密鍵、本番必須)
CURSOR_SECRET=generate-a-strong-random-cursor-secret-here

# 信頼するリバースプロキシのホップ数 (Cloud Run 標準は 1)
TRUSTED_PROXY_HOPS=1

# CORS 許可オリジン (カンマ区切り、末尾スラッシュなし)
ALLOWED_ORIGINS=http://localhost:3000
