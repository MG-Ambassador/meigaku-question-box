# ==============================================================================
# 明学の質問箱 (Meigaku Question Box) バックエンド API 環境変数設定例 (server/.env)
# ==============================================================================

# サーバーポート
PORT=8080

# 実行環境 (development | test | production)
NODE_ENV=development

# Google Cloud プロジェクトID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Cloud Firestore データベースID (デフォルトDBの場合は (default))
FIRESTORE_DATABASE_ID=(default)

# ローカルで Firestore Emulator を使用する場合のみ設定 (例: localhost:8085)
# FIRESTORE_EMULATOR_HOST=localhost:8085

# 運営アカウント（ID・パスワード）は Firestore の operators コレクションで管理します。
# 最初の運営責任者は `npm run operator:create -- --login-id <ID> --display-name <名前> --role owner --execute` で作成します。

# レート制限・ログイン試行制限用の HMAC 秘密鍵 (本番必須)
RATE_LIMIT_SECRET=generate-a-strong-random-secret-here

# 質問一覧ページネーションのカーソル署名キー (HMAC-SHA256 秘密鍵、本番必須)
CURSOR_SECRET=generate-a-strong-random-cursor-secret-here

# 質問投稿の上限（いずれも10分あたりの件数。0 でその制限をなくす）
# 端末（ブラウザ）ごと。既定 5
SUBMISSION_LIMIT_PER_DEVICE=5
# 回線（IP）ごと。会場 Wi-Fi で大勢が同じ IP を使っても届かない値にする。既定 300
SUBMISSION_LIMIT_PER_IP=300

# 同じ部屋への投稿の順番待ち（1インスタンス内で1件ずつ処理する）
# 待ち行列の上限件数。超えたら 503 SUBMISSION_BUSY。既定 200
SUBMISSION_QUEUE_MAX=200
# 順番待ちの上限（ミリ秒）。超えたら処理を始めずに 503 SUBMISSION_BUSY。既定 5000
SUBMISSION_QUEUE_WAIT_MS=5000
# 応答までの上限（ミリ秒）。超えたら 503 SUBMISSION_UNCERTAIN。Cloud Run のタイムアウト10秒より短く。既定 8000
SUBMISSION_DEADLINE_MS=8000

# 信頼するリバースプロキシのホップ数 (Cloud Run 標準は 1)
TRUSTED_PROXY_HOPS=1

# CORS 許可オリジン (カンマ区切り、末尾スラッシュなし)
ALLOWED_ORIGINS=http://localhost:3000
